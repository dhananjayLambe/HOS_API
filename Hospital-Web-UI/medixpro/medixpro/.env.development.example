# Docker build-time rewrite destination; no trailing /api.
# The local backend Docker stack exposes Nginx at host port 8000.
BACKEND_PROXY_TARGET=http://host.docker.internal:8000

# Next.js route handlers use this value at runtime; it must end in /api/.
DJANGO_API_URL=http://host.docker.internal:8000/api/

# Docker Compose requires a hostname even though development does not start Nginx.
NGINX_SERVER_NAME=localhost

