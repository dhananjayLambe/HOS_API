# DoctorProCare backend — development
# Copy to .env.development and fill in values. Do not commit the filled file.

# Core
SECRET_KEY=asdfghjkl;qwertyuiop;zxcvbnm
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal
ENVIRONMENT=development
DJANGO_TIME_ZONE=Asia/Kolkata

# Database
DB_NAME=demo5_db
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# CORS / CSRF (development also allows all origins in settings)
# Include :8000/:8080 so Django admin/Swagger behind Docker nginx pass CSRF Origin checks.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Docker Compose overrides DB_HOST=postgres and REDIS_HOST=redis inside containers.
# Keep localhost here for venv/runserver. Set DB_PASSWORD; Compose PostgreSQL requires it.

# Reports / S3
AWS_REPORTS_BUCKET=
AWS_REGION=ap-south-1
AWS_S3_REGION_NAME=ap-south-1
REPORT_ARTIFACT_STORAGE=local
REPORT_PUBLIC_DOWNLOAD_BASE_URL=
MAX_REPORT_UPLOAD_SIZE_MB=20
MAX_REPORT_BATCH_UPLOAD_SIZE_MB=100
REPORT_DELIVERY_ASYNC=true
IDEMPOTENCY_KEY_TTL_HOURS=24

# WhatsApp / Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PRESCRIPTION_TEMPLATE_NAME=consultant_utlity
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en
WHATSAPP_USE_SIMULATED_PROVIDER=true
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Logging
LOG_LEVEL=INFO
SERVICE_NAME=doctorprocare-api
APPLICATION_VERSION=0.0.0
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=
LOG_RETENTION_DAYS=90
