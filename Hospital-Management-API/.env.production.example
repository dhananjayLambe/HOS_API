# DoctorProCare backend — production
# Copy to .env.production on the production host only.
# Do not commit the filled file. DEBUG must remain false.

# Core
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=api.example.com
ENVIRONMENT=production
DJANGO_TIME_ZONE=Asia/Kolkata

# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Redis / Celery
REDIS_HOST=
REDIS_PORT=6379
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=false

# CORS / CSRF — comma-separated full origins
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# TLS
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Keep these false until every applicable subdomain is HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Reports / S3
AWS_REPORTS_BUCKET=
AWS_REGION=ap-south-1
AWS_S3_REGION_NAME=ap-south-1
REPORT_ARTIFACT_STORAGE=s3
REPORT_PUBLIC_DOWNLOAD_BASE_URL=
MAX_REPORT_UPLOAD_SIZE_MB=20
MAX_REPORT_BATCH_UPLOAD_SIZE_MB=100
REPORT_DELIVERY_ASYNC=true
IDEMPOTENCY_KEY_TTL_HOURS=24

# WhatsApp / Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PRESCRIPTION_TEMPLATE_NAME=consultant_utlity
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en
WHATSAPP_USE_SIMULATED_PROVIDER=false
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Logging
LOG_LEVEL=INFO
SERVICE_NAME=doctorprocare-api
APPLICATION_VERSION=0.0.0
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=
LOG_RETENTION_DAYS=90
