# Copy to uat-env.env in this directory (gitignored) and fill real values.
#   cp scripts/aws/uat-env.env.example scripts/aws/uat-env.env

AWS_REGION=ap-south-1

# Comma-separated EC2 Name tags. Must match instances tagged Environment=uat.
UAT_EC2_NAME_TAGS=hos-uat-web-01,hos-uat-api-01

# RDS instance identifier. Must be tagged Environment=uat.
UAT_RDS_INSTANCE_ID=hos-uat-postgres

# Optional: bucket size in `status`. Leave empty to skip.
UAT_S3_BUCKET=hos-uat-media-123456789012

# Optional: curl after `enable`. Use the API Elastic IP until DNS exists.
UAT_API_HEALTH_URL=http://203.0.113.10/health/
